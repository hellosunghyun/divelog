{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "../../packages/db/src/**/*",
    "../../packages/domain/src/**/*",
    "../../packages/server/src/**/*",
    "workers/**/*",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "@divelog/db": ["../../packages/db/src/index.ts"],
      "@divelog/db/*": ["../../packages/db/src/*"],
      "@divelog/domain": ["../../packages/domain/src/index.ts"],
      "@divelog/domain/*": ["../../packages/domain/src/*"],
      "@divelog/server": ["../../packages/server/src/index.ts"],
      "@divelog/server/*": ["../../packages/server/src/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
