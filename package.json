{
  "name": "divelog",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && node scripts/patch-worker.mjs",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy --config wrangler.deploy.toml",
    "dev": "react-router dev",
